# Copy to .env and adjust. The service refuses to start if anything required is
# missing, rather than failing on the first request that needs it.

APP_ENV=development
PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/infographic?sslmode=disable

# At least 32 characters. Changing it signs everyone out — that is the point.
JWT_SECRET=change-me-to-something-long-and-random-please

# Browser origins allowed to call this API. No wildcard: these requests carry
# credentials, and "*" would let any site drive somebody's account.
EDITOR_ORIGINS=http://localhost:3000

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Leave empty in development so the refresh cookie is host-only. Set it when the
# API and the editor share a parent domain.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Diagrams above this are refused. Generous on purpose while the editor still
# inlines background images as base64 — a tight cap would refuse saves the
# client has no other way to make. Lower it once images move to /assets.
MAX_DOCUMENT_BYTES=8388608

# Uploaded images. Local disk today; the Storage interface in internal/storage
# is where an S3 or R2 adapter goes.
ASSET_DIR=./data/assets
MAX_ASSET_BYTES=10485760
ASSET_URL_TTL=1h

# Rate limiting. Counters live in this process, so with more than one instance
# the effective limit multiplies — move the store to Redis before scaling out.
RATE_LIMIT_ENABLED=true
API_REQUESTS_PER_IP=300
API_REQUEST_WINDOW=1m
AUTH_ATTEMPTS_PER_IP=20
AUTH_ATTEMPT_WINDOW=1m
LOGIN_ATTEMPTS_PER_USER=5
LOGIN_ATTEMPT_WINDOW=15m

# Development shortcut. Production uses migrations/.
AUTO_MIGRATE=false
